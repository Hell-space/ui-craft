config_version=5

[application]
config/name="潮标 · 近岸测绘"
run/main_scene="res://station.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=680
window/size/window_width_override=1120
window/size/window_height_override=680
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.088, 0.16, 1)
